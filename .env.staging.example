# Staging — copie para /opt/warehouseflow/staging/.env.staging
#   cp .env.staging.example .env.staging
# Nunca commite secrets reais.

APP_ENV=staging
APP_VERSION=staging

# Credenciais PostgreSQL (serviço db — não publicar porta)
POSTGRES_USER=warehouse_staging
POSTGRES_PASSWORD=SUBSTITUA_SENHA_FORTE_STAGING
POSTGRES_DB=warehouseflow_staging

# URL interna Docker (host = nome do serviço "db")
DATABASE_URL=postgresql+psycopg2://warehouse_staging:SUBSTITUA_SENHA_FORTE_STAGING@db:5432/warehouseflow_staging

# Obrigatória e forte — sem fallback no Compose de produção
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SECRETA_ALEATORIA_LONGA

# HTTP com IP público: false. Após HTTPS: true
COOKIE_SECURE=false

# Restringir documentação em staging (altere para true se precisar depurar)
ENABLE_DOCS=false

# Porta HTTP publicada no host (Nginx)
HTTP_PORT=80
