# Copie para .env e ajuste conforme o ambiente:
#   cp .env.example .env
#
# Com a API rodando FORA do Docker (uvicorn no host) e só o Postgres no Compose:
DATABASE_URL=postgresql+psycopg2://warehouse:warehouse@localhost:5433/warehouseflow
#
# Com `docker compose up --build`, o docker-compose.yml sobrescreve DATABASE_URL
# para a rede interna: postgresql+psycopg2://warehouse:warehouse@db:5432/warehouseflow
#
# Chave usada para assinar JWT (altere em ambientes compartilhados)
SECRET_KEY=altere-esta-chave-em-desenvolvimento
