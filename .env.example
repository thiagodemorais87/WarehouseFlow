# Copie para .env e ajuste conforme o ambiente.
#
# Com a API rodando FORA do Docker (uvicorn no host) e só o Postgres no Compose:
DATABASE_URL=postgresql+psycopg2://warehouse:warehouse@localhost:5432/warehouseflow
#
# Com `docker compose up --build` (serviço api + db), a URL interna é injetada
# automaticamente pelo docker-compose.yml:
# DATABASE_URL=postgresql+psycopg2://warehouse:warehouse@db:5432/warehouseflow
