# Copie para .env e ajuste conforme o ambiente:
#   cp .env.example .env
#
# Nunca commite .env com secrets reais.

# --- Banco ---
# Com a API rodando FORA do Docker (uvicorn no host) e só o Postgres no Compose:
DATABASE_URL=postgresql+psycopg2://USUARIO:SENHA@localhost:5433/NOME_DO_BANCO
#
# Com `docker compose up --build`, o docker-compose.yml sobrescreve DATABASE_URL
# para a rede interna: postgresql+psycopg2://warehouse:warehouse@db:5432/warehouseflow

# --- Segurança ---
# Chave usada para assinar JWT (obrigatória; altere em ambientes compartilhados)
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SECRETA_ALEATORIA

# Ambiente lógico: development | staging | production
APP_ENV=development

# Cookie JWT Secure: false em HTTP local; true somente após HTTPS
COOKIE_SECURE=false

# Swagger/OpenAPI (/docs, /redoc, /openapi.json): true em desenvolvimento
ENABLE_DOCS=true

# --- Aplicação ---
# Versão alinhada à tag/GitHub Release (ex.: v2.0.0-rc.1). Sem tag: use "dev".
APP_VERSION=dev

# Diretório do frontend Jinja/static (opcional; Compose define /app/frontend)
# FRONTEND_DIR=./frontend
