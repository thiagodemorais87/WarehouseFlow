# Copie para .env.monitoring e ajuste os valores.
# Nunca versionar .env.monitoring com senhas reais.

# --- Rede da aplicação (external) ---
# Descubra com: docker network ls
# Dev:           warehouseflow_default
# Staging:       warehouseflow-staging_default
# Produção:      warehouseflow-production_default
APP_NETWORK=warehouseflow_default

# --- Host Debian visto pelos containers (Server → Agent 2) ---
# Tipicamente o gateway docker0 no Debian: ip -4 addr show docker0
# Exemplo: 172.17.0.1
# NÃO usar host.docker.internal.
ZABBIX_AGENT_HOST=172.17.0.1

# Subnet da rede Compose "monitoring" (para ufw no Agent).
# Descubra após o primeiro up: docker network inspect warehouseflow-monitoring_monitoring
MONITORING_SUBNET=172.28.0.0/16

# --- PostgreSQL exclusivo do Zabbix (NÃO é o banco WarehouseFlow) ---
ZABBIX_POSTGRES_USER=zabbix
ZABBIX_POSTGRES_PASSWORD=CHANGE_ME_ZABBIX_DB
ZABBIX_POSTGRES_DB=zabbix

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA

# --- Postgres exporter (banco da aplicação, usuário read-only) ---
# Crie o role no Postgres da app (ver docs/devops/prometheus.md).
# Host "db" resolve na APP_NETWORK.
POSTGRES_EXPORTER_DSN=postgresql://monitoring:CHANGE_ME_MONITORING@db:5432/warehouseflow?sslmode=disable

# --- Blackbox (referência; targets estão em monitoring/prometheus/prometheus.yml) ---
# Staging/prod: http://frontend/health e http://frontend/ready
# Dev/lab:      http://api:8000/health e http://api:8000/ready
WF_HEALTH_URL=http://api:8000/health
WF_READY_URL=http://api:8000/ready

# Fuso do frontend Zabbix
PHP_TZ=America/Sao_Paulo
