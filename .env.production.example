# Produção — copie para /opt/warehouseflow/production/.env.production
#   cp .env.production.example .env.production
# Nunca commite secrets reais.

APP_ENV=production
APP_VERSION=v2.0.0

# Credenciais PostgreSQL (serviço db — não publicar porta)
POSTGRES_USER=warehouse_prod
POSTGRES_PASSWORD=SUBSTITUA_SENHA_FORTE_PRODUCAO
POSTGRES_DB=warehouseflow_prod

# URL interna Docker (host = nome do serviço "db")
DATABASE_URL=postgresql+psycopg2://warehouse_prod:SUBSTITUA_SENHA_FORTE_PRODUCAO@db:5432/warehouseflow_prod

# Obrigatória e forte — sem fallback no Compose de produção
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SECRETA_ALEATORIA_LONGA

# HTTP com IP público: false. Após ativar HTTPS: true
COOKIE_SECURE=false

# Documentação OpenAPI desabilitada em produção
ENABLE_DOCS=false

# Porta HTTP publicada no host (Nginx)
HTTP_PORT=80
